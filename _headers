# Cloudflare Pages response headers — https://developers.cloudflare.com/pages/configuration/headers/
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# fonts are content-hashed by name and never change in place
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/css/*
  Cache-Control: public, max-age=86400, must-revalidate

/assets/js/*
  Cache-Control: public, max-age=86400, must-revalidate

/images/*
  Cache-Control: public, max-age=2592000

/samuel-wesley-mondal.vcf
  Content-Type: text/vcard; charset=utf-8
  Content-Disposition: attachment; filename="samuel-wesley-mondal.vcf"
